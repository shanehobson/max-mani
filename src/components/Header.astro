---
import Logo from "~/components/Logo.astro";
import { NAV_LINKS, SITE } from "~/lib/config";
---

<header
  id="site-header"
  class="sticky top-0 z-40 bg-transparent border-b border-black transition-[backdrop-filter] duration-200"
>
  <div class="mx-auto max-w-site px-6 h-16 flex items-center justify-between">
    <a href="#top" class="font-display leading-none flex flex-col items-start" aria-label={SITE.name}>
      <Logo heightClass="h-5" />
      <span class="block text-[0.6rem] tracking-[0.35em] text-ink-muted mt-1">MANICURE</span>
    </a>

    <nav class="hidden md:flex items-center gap-8">
      {
        NAV_LINKS.map((link) => (
          <a href={link.href} class="nav-link">
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <button type="button" class="btn-outline hidden md:inline-flex text-nav" data-book-now>
        Book Now
      </button>
      <button
        type="button"
        class="md:hidden p-2"
        aria-label="Toggle menu"
        data-mobile-toggle
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 6h18M3 12h18M3 18h18" />
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    class="md:hidden grid grid-rows-[0fr] bg-transparent transition-[grid-template-rows] duration-300 ease-out"
    aria-hidden="true"
  >
    <div class="overflow-hidden">
      <ul class="px-6 py-4 flex flex-col gap-3">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a href={link.href} class="nav-link block py-1">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-mobile-toggle]");
  const menu = document.getElementById("mobile-nav");
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      if (open) menu.style.transition = "";
      menu.classList.toggle("grid-rows-[1fr]", open);
      menu.classList.toggle("grid-rows-[0fr]", !open);
      menu.setAttribute("aria-hidden", String(!open));
      toggle.setAttribute("aria-expanded", String(open));
    };
    toggle.setAttribute("aria-expanded", "false");
    toggle.addEventListener("click", () =>
      setOpen(menu.classList.contains("grid-rows-[0fr]")),
    );
    // The header is sticky and in normal flow, so the open menu adds its
    // height to the page. If the menu animates closed while the browser
    // jumps to the anchor, the collapse shifts the content up and buries
    // the section's top under the header (Safari has no scroll anchoring
    // to compensate). Collapse instantly so the header is already back to
    // its bar height when the anchor's scroll position is computed.
    menu.querySelectorAll<HTMLAnchorElement>("a").forEach((a) =>
      a.addEventListener("click", () => {
        menu.style.transition = "none"; // restored by the next setOpen(true)
        setOpen(false);
        void menu.offsetHeight; // flush layout before the default anchor jump
      }),
    );
  }

  const header = document.getElementById("site-header");
  if (header) {
    const update = () => header.classList.toggle("backdrop-blur-xl", window.scrollY > 4);
    update();
    window.addEventListener("scroll", update, { passive: true });
  }
</script>
