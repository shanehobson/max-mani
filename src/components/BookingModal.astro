---
import { ZAERA } from "~/lib/config";
---

<dialog
  id="booking-modal"
  class="p-0 m-0 bg-transparent backdrop:bg-ink/60 w-screen h-[100dvh] max-w-none max-h-none md:w-full md:h-auto md:max-w-[1100px] md:max-h-[calc(100vh-2rem)] md:m-auto md:rounded-md"
>
  <div class="relative bg-cream-50 w-full h-full md:h-auto md:aspect-[4/3] overflow-hidden">
    <button
      type="button"
      data-booking-close
      aria-label="Close booking"
      class="absolute top-3 right-[27px] z-10 inline-flex h-9 w-9 items-center justify-center rounded-full bg-ink/80 text-cream-50 hover:bg-ink"
    >
      ✕
    </button>
    <iframe
      id="booking-iframe"
      title="Book an appointment"
      class="w-full h-full border-0"
      loading="lazy"
      allow="payment; clipboard-write"
    ></iframe>
  </div>
</dialog>

<script define:vars={{ bookingUrl: ZAERA.bookingIframeUrl }}>
  const dialog = document.getElementById("booking-modal");
  const iframe = document.getElementById("booking-iframe");
  if (dialog instanceof HTMLDialogElement && iframe instanceof HTMLIFrameElement) {
    let currentSrc = "";
    const lockScroll = () => {
      document.documentElement.style.overflow = "hidden";
    };
    const unlockScroll = () => {
      document.documentElement.style.overflow = "";
    };
    const buildUrl = (service) => {
      const url = new URL(bookingUrl, window.location.origin);
      if (service) url.searchParams.set("service", service);
      return url.toString();
    };
    const open = (service) => {
      const nextSrc = buildUrl(service);
      if (nextSrc !== currentSrc) {
        iframe.src = nextSrc;
        currentSrc = nextSrc;
      }
      lockScroll();
      dialog.showModal();
    };
    document.querySelectorAll("[data-book-now]").forEach((el) => {
      el.addEventListener("click", (e) => {
        e.preventDefault();
        const service = el instanceof HTMLElement ? el.dataset.service : undefined;
        open(service);
      });
    });
    document.addEventListener("book:open", (e) => {
      const detail = e instanceof CustomEvent ? e.detail : null;
      open(detail?.service);
    });
    dialog.querySelector("[data-booking-close]")?.addEventListener("click", () =>
      dialog.close(),
    );
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener("close", unlockScroll);
  }
</script>
