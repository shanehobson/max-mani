---
import { Image } from "astro:assets";
import ksenia from "~/assets/about/ksenia.png";
import MyWorkCarousel from "~/components/islands/MyWorkCarousel.tsx";

const galleryModules = import.meta.glob(
  "../assets/gallery/*.{jpg,jpeg,png,JPG,JPEG,PNG}",
  { eager: true, query: "?url", import: "default" },
) as Record<string, string>;
const slides = Object.entries(galleryModules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, url]) => url);
---

<section id="about" class="section-shell !pt-0">
  <div class="grid md:grid-cols-[1.25fr_1fr] gap-10 md:gap-16 items-start">
    <div class="order-1">
      <Image
        src={ksenia}
        alt="Ksenia, owner of Max Mani"
        class="w-full max-w-[16rem] mx-auto md:mx-0 h-auto"
        widths={[256, 384, 512]}
        sizes="(min-width: 768px) 256px, 60vw"
      />
      <div class="mt-6 max-w-prose mx-auto md:mx-0">
        <h3 class="font-display text-2xl mb-3">
          <span class="font-semibold uppercase tracking-wide text-offwhite">I'm Ksenia</span>
          <span class="text-ink-muted text-base font-body normal-case"
            > — a licensed nail technician from Ukraine with 9 years of experience
            specializing in clean, elegant hard gel manicure and pedicure.
          </span>
        </h3>
        <p class="text-ink-muted leading-relaxed">
          For the past 3 years, I've been working in the USA. I truly love helping
          women feel confident and cared for through beautiful, long-lasting nails
          and a relaxing private studio experience where every detail matters.
        </p>
      </div>
    </div>

    <div class="order-2">
      <div class="relative w-full max-w-[416px] mx-auto md:ml-auto md:mr-0 pb-[61px]">
        <!-- Bordered frame, inset on right/bottom so the photo overhangs -->
        <div
          class="absolute left-0 top-0 right-8 bottom-[65px] border border-brown pointer-events-none"
        >
        </div>

        <!-- Photo card, offset down-right to overlap the frame's bottom-right -->
        <div class="relative z-10 ml-8 mt-[17px]">
          <MyWorkCarousel client:visible slides={slides} />
        </div>

        <!-- "MY WORK" label masking the top of the frame -->
        <div class="absolute top-[27px] left-[-14px] z-20 bg-white/10 backdrop-blur-md px-3 py-1.5">
          <h3 class="font-display text-4xl md:text-section-title uppercase tracking-wide text-offwhite">
            My Work
          </h3>
        </div>
      </div>
    </div>
  </div>
</section>
