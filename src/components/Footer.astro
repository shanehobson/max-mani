---
import { SITE, ADDRESS } from "~/lib/config";
---

<footer class="border-t border-ink/10 mt-10">
  <div class="mx-auto max-w-site px-6 py-8 flex flex-col items-center gap-4 text-sm">
    <div class="flex flex-col md:flex-row items-center justify-center gap-3 md:gap-6">
      <a href={`tel:${SITE.phone}`} class="inline-flex items-center gap-2 hover:text-brown">
        <svg aria-hidden="true" class="h-5 w-5 text-brown" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
        </svg>
        {SITE.phoneDisplay}
      </a>
      <a href={`mailto:${SITE.email}`} class="inline-flex items-center gap-2 hover:text-brown">
        <img src="/icons/gmail.png" alt="" aria-hidden="true" class="h-5 w-5" />
        {SITE.email}
      </a>
      <a href={SITE.instagramUrl} target="_blank" rel="noreferrer" class="inline-flex items-center gap-2 hover:text-brown">
        <img src="/icons/instagram.png" alt="" aria-hidden="true" class="h-5 w-5" />
        @{SITE.instagram}
      </a>
    </div>

    <a href={ADDRESS.mapsUrl} target="_blank" rel="noreferrer" class="inline-flex items-center gap-2 hover:text-brown">
      <svg aria-hidden="true" class="h-5 w-5 text-brown" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
        <circle cx="12" cy="10" r="3" />
      </svg>
      <address class="not-italic">{ADDRESS.display}</address>
    </a>

    <button type="button" class="btn-outline text-sm" data-book-now>
      Book Now
    </button>
  </div>
</footer>
