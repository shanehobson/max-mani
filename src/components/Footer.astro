---
import { SITE } from "~/lib/config";
---

<footer class="border-t border-ink/10 mt-10">
  <div class="mx-auto max-w-site px-6 py-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 text-sm">
    <div class="flex flex-col md:flex-row md:items-center gap-3 md:gap-6">
      <a href={`tel:${SITE.phone}`} class="inline-flex items-center gap-2 hover:text-brown">
        <span aria-hidden="true" class="inline-flex h-6 w-6 items-center justify-center rounded-sm bg-brown text-cream-50 text-xs">IG</span>
        {SITE.phoneDisplay}
      </a>
      <a href={`mailto:${SITE.email}`} class="inline-flex items-center gap-2 hover:text-brown">
        <span aria-hidden="true" class="inline-flex h-6 w-6 items-center justify-center rounded-sm bg-brown text-cream-50 text-xs">M</span>
        {SITE.email}
      </a>
      <a href={SITE.instagramUrl} target="_blank" rel="noreferrer" class="hover:text-brown">
        @{SITE.instagram}
      </a>
    </div>

    <button type="button" class="btn-outline text-sm" data-book-now>
      Book Now
    </button>
  </div>
</footer>
