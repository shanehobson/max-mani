---
import "~/styles/global.css";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import BookingModal from "~/components/BookingModal.astro";
import { SITE } from "~/lib/config";
import pageBg from "~/assets/background/page-background.jpeg";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${SITE.name} — Nail art studio in Naples, FL`,
  description = "Hard gel manicure, pedicure, and nail art by Ksenia. Naples, FL.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Manrope:wght@400;500;600;700&display=swap"
    />
    <title>{title}</title>
  </head>
  <body style={`--page-bg: url(${pageBg.src});`}>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <BookingModal />
  </body>
</html>
